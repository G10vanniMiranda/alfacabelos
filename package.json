{
  "name": "alfa-cabelos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts",
    "check:sensitive-files": "node scripts/check-sensitive-files.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "validate:production": "tsx scripts/validate-production.ts",
    "test:integration": "tsx scripts/validate-production.ts --write-tests",
    "test:api": "tsx scripts/test-api-concurrency.ts",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "screenshots:auth": "tsx scripts/capture-auth-screenshots.ts",
    "notifications:process": "tsx scripts/retry-notifications.ts",
    "notifications:retry": "npm run notifications:process --",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx --tsconfig tsconfig.json scripts/create-admin-access.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.3.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.0",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.3",
    "@img/sharp-wasm32": "0.35.4"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "postcss": "8.5.25",
    "sharp": "0.35.4",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.4"
    }
  }
}
