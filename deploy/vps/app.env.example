# Copy to app.env on the VPS (chmod 600). Never commit the real file.
# homologation for staging, production only after GO
APP_ENV=homologation
APP_URL=https://<approved-host>
NEXT_PUBLIC_APP_URL=https://<approved-host>

# Supabase pooler URL of the matching project
DATABASE_URL=
# Supabase direct URL (migrations run separately, not by this container)
DIRECT_URL=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
# identity baselines used by the environment guards
PRODUCTION_SUPABASE_PROJECT_REF=
PRODUCTION_APP_HOST=
PRODUCTION_STORAGE_BUCKET=

# same value as scheduler.env; 32+ random bytes
CRON_SECRET=
# unique per environment; 48+ random bytes
PASSWORD_RESET_SECRET=

# stays false until an authorized canary round
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_INSTANCE_ID=
WHATSAPP_OWNER_PHONE=
# Homologation guard: production Evolution instance id, so staging can never reuse it
PRODUCTION_EVOLUTION_INSTANCE_ID=
