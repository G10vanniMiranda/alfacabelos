# Non-secret deployment settings, passed with: docker compose --env-file deploy.env ...
# git SHA being deployed (image tag)
APP_VERSION=
# approved hostname; Traefik issues its certificate
APP_HOST=
# existing external network Traefik watches
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
