# Banco PostgreSQL/Supabase (obrigatório)
APP_ENV=development
HOMOLOGATION_TARGET_CONFIRMED=false
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@DB_HOST:5432/postgres

# URL pública usada em links de confirmação e recuperação (obrigatório em produção)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Storage Supabase (obrigatório para galeria persistente)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=PROJECT_REF
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=galeria

# Baseline não secreta usada para impedir que homologação reutilize produção
PRODUCTION_SUPABASE_PROJECT_REF=
PRODUCTION_APP_HOST=
PRODUCTION_STORAGE_BUCKET=

# WhatsApp (opcional; habilite somente com todas as credenciais)
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=custom
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_OWNER_PHONE=
WHATSAPP_INSTANCE_ID=
PRODUCTION_EVOLUTION_INSTANCE_ID=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_REQUEST_TIMEOUT_MS=10000
BARBERSHOP_ADDRESS=

# Worker transacional de notificações
CRON_SECRET=
NOTIFICATION_BATCH_SIZE=25
NOTIFICATION_CONCURRENCY=5
NOTIFICATION_MAX_ATTEMPTS=8
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_DEAD_RETENTION_DAYS=365
NOTIFICATION_REMINDER_LEAD_MINUTES=1440
NOTIFICATION_REMINDER_WINDOW_MINUTES=10

# Diagnóstico estruturado opcional
BOOKING_DIAGNOSTICS=false
OBSERVABILITY_DEBUG=false
APP_VERSION=

# Limites avaliados pela observabilidade; o envio externo de alertas depende do provedor escolhido
ALERT_OUTBOX_BACKLOG=50
ALERT_OUTBOX_OLDEST_SECONDS=900
ALERT_WORKER_STALE_SECONDS=900
ALERT_DATABASE_LATENCY_MS=500
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
ALERT_COOLDOWN_SECONDS=900
ALERT_WEBHOOK_TIMEOUT_MS=5000
